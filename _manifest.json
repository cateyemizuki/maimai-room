{
  "manifest_version": 2,
  "id": "cateye.maimai_room",
  "version": "1.3.0",
  "name": "麦麦的小屋",
  "description": "MaiBot SDK 自定义 3D 房间。QQ 与受限 bot 状态工具、第三方行为与日程接管、固定作息、菜园和插件视频接口。",
  "author": {
    "name": "cateye",
    "url": "https://github.com/cateyemizuki"
  },
  "urls": {
    "repository": "https://github.com/cateyemizuki/maimai-room",
    "homepage": "https://github.com/cateyemizuki/maimai-room"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.3.19",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.20.0",
    "max_version": "2.99.99"
  },
  "plugin_type": "deskpet",
  "dependencies": [
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10.0.0"
    }
  ],
  "capabilities": [
    "send.text",
    "api.call",
    "config.get",
    "llm.generate",
    "llm.get_available_models",
    "component.enable",
    "component.disable",
    "chat.open_session",
    "api.get"
  ],
  "display": {
    "icon": {
      "type": "local",
      "value": "room-logo.webp",
      "fallback": "house"
    }
  },
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
